{
  "name": "@autosort/core",
  "version": "0.3.0",
  "description": "The AutoSort engine: split a Spotify playlist into rule-based smart playlists, sort by BPM, key and the Camelot wheel, and keep everything in sync.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "spotify",
    "playlist",
    "sort",
    "smart-playlists",
    "camelot",
    "harmonic-mixing",
    "bpm"
  ],
  "homepage": "https://autosort.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamtravjohnson/autosort.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
