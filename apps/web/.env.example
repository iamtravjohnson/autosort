# Required: from your Spotify developer app (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Set automatically by Vercel's Neon integration when you use the Deploy button
DATABASE_URL=

# Optional: signs sessions and encrypts Spotify tokens. Generated and stored in the database if unset.
AUTH_SECRET=

# Optional: protects the daily sync endpoint (Vercel Cron sends it automatically when set)
CRON_SECRET=

# Optional: free key from https://www.last.fm/api/account/create (better mood and theme playlists)
LASTFM_API_KEY=

# Optional: photo covers for new smart playlists (https://openrouter.ai/keys).
# Only the playlist's name and rule are sent, never songs or artists.
OPENROUTER_API_KEY=
# Optional: image model (default google/gemini-3-pro-image)
OPENROUTER_IMAGE_MODEL=

# Optional: this app's public URL, including any BASE_PATH, if it can't be detected
# (e.g. https://example.com/autosort when another site shows it)
APP_URL=
# Optional: serve AutoSort under a path on another site, e.g. /autosort. Set it with APP_URL,
# and on the other site rewrite /autosort/* to this deployment's /autosort/*.
BASE_PATH=
